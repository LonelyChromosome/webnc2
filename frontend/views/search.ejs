<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Tìm kiếm</title>
</head>
<body>
  <a href="/users/create" style="position: fixed; top: 12px; right: 16px;">Tạo tài khoản</a>
  <h1>Tìm kiếm bài viết</h1>
  <form method="GET" action="/search">
    <input type="text" name="keyword" placeholder="Nhập từ khóa" value="<%= keyword || '' %>">
    <button type="submit">Tìm kiếm</button>
  </form>

  <% if (keyword) { %>
    <p>Bạn đang tìm kiếm tin tức về: <%= keyword %></p>
    <% if (newsList.length > 0) { %>
      <h1>Danh sách tin tức</h1>
      <% newsList.forEach((item) => { %>
        <ul>
          <li><a href="/news/<%= item.id %>"><%= item.title %></a></li>
        </ul>
      <% }) %>
    <% } else { %>
      <h1>Không tìm thấy bài viết</h1>
    <% } %>
  <% } %>
</body>
</html>
